{
  "name": "tauri-bun-react-shadcn-ui-app",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "bun run lint:frontend && bun run lint:rust && bun run lint:md",
    "lint:frontend": "biome check .",
    "lint:rust": "cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:md": "markdownlint-cli2",
    "lint:fix": "biome check --write . && cargo fmt --all --manifest-path src-tauri/Cargo.toml && markdownlint-cli2 --fix"
  },
  "dependencies": {
    "@base-ui/react": "=1.8.0",
    "@fontsource-variable/geist": "=5.3.0",
    "@tailwindcss/vite": "=4.3.3",
    "@tauri-apps/api": "=2.11.1",
    "@tauri-apps/plugin-opener": "=2.5.5",
    "class-variance-authority": "=0.7.1",
    "cn": "=0.2.6",
    "lucide-react": "=1.45.0",
    "react": "=19.3.0",
    "react-dom": "=19.3.0",
    "shadcn": "=4.21.0",
    "tailwindcss": "=4.3.3",
    "tw-animate-css": "=1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "=2.5.13",
    "@tauri-apps/cli": "=2.11.4",
    "@types/node": "=26.5.1",
    "@types/react": "=19.3.0",
    "@types/react-dom": "=19.3.0",
    "@vitejs/plugin-react": "=6.1.1",
    "markdownlint-cli2": "=0.23.2",
    "typescript": "=7.0.2",
    "vite": "=8.3.0"
  }
}
