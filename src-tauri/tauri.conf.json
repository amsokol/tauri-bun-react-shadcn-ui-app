{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-bun-react-shadcn-ui-app",
  "version": "0.1.3",
  "identifier": "com.amsokol.tauri-bun-react-shadcn-ui-app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri + React + shadcn/ui",
        "width": 800,
        "height": 600,
        "minWidth": 330,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["micaLight", "micaDark"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
